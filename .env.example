# SENSOTECH Environment Variables
# Copy this file to .env for local development.
# In Docker Compose, DATABASE_URL is set automatically.

# ── Database (local infra — managed by docker-compose) ──
DATABASE_URL=postgresql://sensotech:sensotech_dev@localhost:5432/sensotech

# ── External Integrations (Phase 4+) ──
# These require real credentials. In Base44, set them via the Secrets dashboard.
# WEATHER_API_KEY=
# SATELLITE_API_KEY=
# MARKET_API_KEY=
# LLM_API_KEY=
